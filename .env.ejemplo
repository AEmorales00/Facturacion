# ============================================================
#  VARIABLES DE ENTORNO DEL BACKEND
# ------------------------------------------------------------
#  Copiar este archivo como .env y poner los valores reales.
#  El archivo .env NO se sube al repositorio (esta en .gitignore).
#
#  En Render / Railway estos mismos nombres se cargan en la
#  seccion "Environment Variables" del panel, no en un archivo.
# ============================================================

# ---- Base de datos en la nube ----
# MySQL:      jdbc:mysql://host:3306/facturacion
# PostgreSQL: jdbc:postgresql://host:5432/facturacion
DB_URL=jdbc:mysql://TU-HOST:3306/facturacion
DB_USER=tu_usuario
DB_PASSWORD=tu_clave

# ---- AWS S3 ----
ALMACENAMIENTO=s3
S3_BUCKET=tu-bucket-de-productos
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# true = bucket privado con URLs firmadas (recomendado)
# false = bucket publico con URL directa
S3_URLS_FIRMADAS=true

# ---- URLs publicas ----
# Dominio donde quedo desplegado el Angular (para CORS).
CORS_ORIGENES=https://tu-frontend.vercel.app
# URL publica de esta misma API.
URL_PUBLICA=https://tu-api.onrender.com
